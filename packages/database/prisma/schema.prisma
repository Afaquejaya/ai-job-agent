// Implemented schema - Phase 2. The full proposed schema is in
// docs/architecture/database-design.md; tables are added phase by phase.
//
// Conventions: UUID primary keys, snake_case tables/columns, timestamptz (UTC), and every
// private table carries user_id with ON DELETE CASCADE.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Authentication (shape required by Better Auth; names mapped to our conventions)
// -----------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  /// Better Auth lower-cases emails before saving.
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  accounts         Account[]
  settings         UserSettings?
  candidateProfile CandidateProfile?
  resumes          Resume[]
  profileAnswers   ProfileAnswer[]
  conversations    AgentConversation[]
  agentMessages    AgentMessage[]
  jobPostings      JobPosting[]
  jobMatches       JobMatch[]
  aiUsageRecords   AiUsageRecord[]
  agentTasks       AgentTask[]
  taskEvents       TaskEvent[]
  taskAttempts     TaskAttempt[]
  taskCheckpoints  TaskCheckpoint[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Random session token (Better Auth looks sessions up by it; see decision D-017).
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (scrypt) for email + password accounts. Never the plain password.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  /// Stored hashed (Better Auth `verification.storeIdentifier: "hashed"`).
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Sign-in/sign-up rate limiting shared by all web instances.
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  /// Milliseconds since epoch.
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// -----------------------------------------------------------------------------
// Settings and profile
// -----------------------------------------------------------------------------

enum SubmissionMode {
  manual_only
  approve_each
  auto_where_permitted

  @@map("submission_mode")
}

model UserSettings {
  userId                String         @id @map("user_id") @db.Uuid
  /// IANA time zone; daily limits and reports are calculated in it.
  timeZone              String         @default("UTC") @map("time_zone")
  submissionMode        SubmissionMode @default(manual_only) @map("submission_mode")
  /// 0-50, enforced by a CHECK constraint in the migration.
  dailyApplicationLimit Int            @default(20) @map("daily_application_limit")
  /// ISO 3166-1 alpha-2 codes.
  targetCountries       String[]       @default([]) @map("target_countries")
  /// When the user allowed sending CV/profile data to the AI provider; null = not allowed.
  aiProcessingConsentAt DateTime?      @map("ai_processing_consent_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// One profile per user. Every field is nullable: null means "not provided" (never inferred).
/// JSON columns are validated by the Zod schemas in @job-agent/shared before every write.
model CandidateProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  fullName              String?  @map("full_name")
  preferredName         String?  @map("preferred_name")
  /// Contact email for applications; may differ from the login email.
  email                 String?
  /// International format, e.g. +919876543210.
  phone                 String?
  currentLocation       Json?    @map("current_location")
  preferredLocations    Json?    @map("preferred_locations")
  professionalSummary   String?  @map("professional_summary")
  totalExperienceMonths Int?     @map("total_experience_months")
  currentRole           String?  @map("current_role")
  education             Json?
  workExperience        Json?    @map("work_experience")
  skills                Json?
  certifications        Json?
  languages             Json?
  workAuthorization     Json?    @map("work_authorization")
  noticePeriod          Json?    @map("notice_period")
  expectedSalary        Decimal? @map("expected_salary") @db.Decimal(12, 2)
  salaryCurrency        String?  @map("salary_currency") @db.Char(3)
  employmentPreferences Json?    @map("employment_preferences")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

enum ResumeExtractionStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  NEEDS_REVIEW
  FAILED

  @@map("resume_extraction_status")
}

/// Immutable CV versions. The file lives in private, encrypted object storage; the extracted
/// text and parsed data are encrypted (AES-256-GCM) before they reach the database.
/// A partial unique index (migration SQL) allows at most one primary resume per user.
model Resume {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @map("user_id") @db.Uuid
  /// Display only, sanitised. Never used as a storage path.
  originalFilename       String                 @map("original_filename")
  /// Server-generated: users/<userId>/resumes/<uuid>
  storageKey             String                 @unique @map("storage_key")
  mimeType               String                 @map("mime_type")
  fileSizeBytes          Int                    @map("file_size_bytes")
  /// SHA-256 of the file bytes (hex); duplicates per user are rejected.
  checksum               String
  version                Int
  extractionStatus       ResumeExtractionStatus @default(UPLOADED) @map("extraction_status")
  /// Encrypted extracted text (the brief's extracted_text).
  extractedTextEncrypted Bytes?                 @map("extracted_text_encrypted")
  /// Encrypted parsed data: deterministic suggestions (the brief's parsed_profile_json).
  parsedProfileEncrypted Bytes?                 @map("parsed_profile_encrypted")
  extractionError        String?                @map("extraction_error")
  isPrimary              Boolean                @default(false) @map("is_primary")
  pageCount              Int?                   @map("page_count")
  textCharCount          Int?                   @map("text_char_count")
  textTruncated          Boolean                @default(false) @map("text_truncated")
  processedAt            DateTime?              @map("processed_at") @db.Timestamptz(3)
  reviewedAt             DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches JobMatch[]

  @@unique([userId, checksum])
  @@unique([userId, version])
  @@index([userId, createdAt])
  @@map("resumes")
}

enum ProfileAnswerStatus {
  DRAFT
  VERIFIED
  ARCHIVED

  @@map("profile_answer_status")
}

enum ProfileAnswerSource {
  USER_ENTERED
  PROFILE_FIELD
  CV_SUGGESTION_CONFIRMED

  @@map("profile_answer_source")
}

/// Reusable answers to recurring application questions. Only VERIFIED answers may be used to
/// fill forms. A partial unique index (migration SQL) allows one non-archived answer per key.
model ProfileAnswer {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  questionKey  String              @map("question_key")
  questionText String              @map("question_text")
  answerType   String              @map("answer_type")
  /// Shape depends on answer_type; validated by answerValueSchemas in @job-agent/shared.
  answerValue  Json                @map("answer_value")
  source       ProfileAnswerSource @default(USER_ENTERED)
  status       ProfileAnswerStatus @default(DRAFT)
  isSensitive  Boolean             @default(false) @map("is_sensitive")
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz(3)
  lastUsedAt   DateTime?           @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("profile_answers")
}

// -----------------------------------------------------------------------------
// Agent chat, pasted jobs, match analyses, AI usage (Phase 2C)
// -----------------------------------------------------------------------------

enum AgentMessageRole {
  user
  assistant

  @@map("agent_message_role")
}

/// A chat with the agent. The title is encrypted (it is taken from the first message).
model AgentConversation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  titleEncrypted Bytes    @map("title_encrypted")
  messageCount   Int      @default(0) @map("message_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId, updatedAt])
  @@map("agent_conversations")
}

/// One chat message. Everything that can contain CV or profile text (the message text, the
/// step trace with thinking summaries, and the provider transcript that must be replayed
/// unchanged) is in the encrypted payload. Plain columns hold metadata only.
model AgentMessage {
  id               String           @id @default(uuid()) @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             AgentMessageRole
  payloadEncrypted Bytes            @map("payload_encrypted")
  model            String?
  stopReason       String?          @map("stop_reason")
  stepCount        Int              @default(0) @map("step_count")
  costUsd          Decimal?         @map("cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("agent_messages")
}

/// A job the user pasted. The URL is a reference only (never fetched); the description is the
/// exact pasted text (a public advert, stored in plain text). A partial unique index (migration
/// SQL) prevents saving the same URL twice per user.
model JobPosting {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  url         String?
  title       String
  company     String
  location    String?
  description String
  source      String   @default("manual_paste")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches JobMatch[]

  @@index([userId, createdAt])
  @@map("job_postings")
}

/// A match analysis. Score and recommendation are computed by our code. The full result
/// (which quotes the CV) is encrypted.
model JobMatch {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  jobPostingId    String   @map("job_posting_id") @db.Uuid
  resumeId        String?  @map("resume_id") @db.Uuid
  resumeVersion   Int?     @map("resume_version")
  model           String
  score           Int?
  recommendation  String
  resultEncrypted Bytes    @map("result_encrypted")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resume     Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, jobPostingId, createdAt])
  @@map("job_matches")
}

/// One row per AI model call, for cost tracking and the monthly budget.
model AiUsageRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  purpose          String
  provider         String
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 6)
  succeeded        Boolean
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage_records")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

enum AuditActor {
  user
  agent
  system

  @@map("audit_actor")
}

/// Append-only: a trigger in the migration rejects UPDATE. Rows are removed only by
/// account deletion (cascade) or the retention job.
model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  actor      AuditActor
  action     String
  targetType String     @map("target_type")
  targetId   String?    @map("target_id")
  /// Identifiers and outcomes only - never secrets or personal content.
  metadata   Json       @default("{}")
  occurredAt DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Durable task engine (Phase 3). PostgreSQL is the source of truth for every background task;
// Redis only schedules when a task runs. State and kind are plain text checked by the database
// against the lists in packages/agent-core (task-state.ts, task.ts).
// ---------------------------------------------------------------------------------------------

model AgentTask {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  kind              String
  state             String    @default("QUEUED")
  /// Ids only (e.g. the job to analyse), validated per kind. Never personal data.
  input             Json      @default("{}")
  /// Ids, counts and scores only.
  output            Json?
  parentTaskId      String?   @map("parent_task_id") @db.Uuid
  idempotencyKey    String    @map("idempotency_key")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  maxAttempts       Int       @default(3) @map("max_attempts")
  deadlineAt        DateTime? @map("deadline_at") @db.Timestamptz(3)
  nextRunAt         DateTime? @map("next_run_at") @db.Timestamptz(3)
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      AgentTask?       @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children    AgentTask[]      @relation("TaskChildren")
  events      TaskEvent[]
  attempts    TaskAttempt[]
  checkpoints TaskCheckpoint[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([state, nextRunAt])
  @@index([state, leaseExpiresAt])
  @@map("agent_tasks")
}

/// Append-only history of every state change: what the user sees as the task timeline.
model TaskEvent {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  fromState      String?  @map("from_state")
  toState        String   @map("to_state")
  reason         String
  failureKind    String?  @map("failure_kind")
  failureMessage String?  @map("failure_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_events")
}

model TaskAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  step        String
  attempt     Int
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  /// running | succeeded | failed | cancelled | abandoned
  outcome     String    @default("running")
  failureKind String?   @map("failure_kind")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, step, attempt])
  @@map("task_attempts")
}

model TaskCheckpoint {
  id                         String    @id @default(uuid()) @db.Uuid
  taskId                     String    @map("task_id") @db.Uuid
  userId                     String    @map("user_id") @db.Uuid
  state                      String
  step                       String
  externalActionDispatchedAt DateTime? @map("external_action_dispatched_at") @db.Timestamptz(3)
  data                       Json      @default("{}")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("task_checkpoints")
}
