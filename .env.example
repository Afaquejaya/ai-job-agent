# =============================================================================
# AI Job Agent - environment variables (NAMES AND PLACEHOLDERS ONLY)
#
# Local development: copy this file to `.env` at the repository root.
#   The web app (next.config.ts) and the worker (src/main.ts) both load it.
# Production: set values in the hosting provider's secret store
#   (Vercel project settings, worker host settings). Never commit real values.
#
# Empty values mean "not configured". The "Phase" note says when a variable is first used.
# Values shown for the local Docker services are development-only defaults that match
# docker-compose.yml; they are not secrets and must never be used in a hosted environment.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Public base URL of the web app. Also the only origin trusted for sign-in requests.
APP_URL=http://localhost:3000

# --- Local Docker services (Phase 2) - read by docker-compose.yml ---------------
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL (Phase 2) - used by web and worker -----------------------------
DATABASE_URL=postgresql://job_agent:job_agent_local_only@localhost:5432/job_agent
# Direct, non-pooled connection used for migrations when the provider pools connections.
DATABASE_DIRECT_URL=
# Separate database for integration and e2e tests (created by docker-compose).
# Test tooling refuses to run unless the database name ends in "_test".
TEST_DATABASE_URL=postgresql://job_agent:job_agent_local_only@localhost:5432/job_agent_test

# --- Redis / BullMQ (Phase 3) - used by web (enqueue) and worker (consume) -----
# Empty = the local docker compose Redis (redis://127.0.0.1:6379). Redis only schedules work;
# every task's state lives in PostgreSQL.
REDIS_URL=
# Key prefix for the queue. Leave the default; tests use their own.
TASK_QUEUE_PREFIX=
# Background tasks one worker runs at the same time (default 2).
WORKER_CONCURRENCY=

# --- Worker ---------------------------------------------------------------------
# Port for the worker's /health and /ready endpoints.
WORKER_HEALTH_PORT=8081

# --- Authentication (Phase 2) --------------------------------------------------
# REQUIRED for sign-in. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Comma-separated emails allowed to create an account. Empty = anyone may sign up in
# development, and NOBODY may sign up in production (safe default for a personal agent).
AUTH_SIGNUP_ALLOWED_EMAILS=
# Password for the synthetic demo account created by `pnpm db:seed` (you choose it,
# at least 12 characters). Development only.
SEED_DEMO_PASSWORD=

# --- Encryption of CV files, extracted CV text and parsed CV data (Phase 2B) ----
# REQUIRED for CV upload. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP: losing this key makes every stored CV unreadable. Never change it casually.
DATA_ENCRYPTION_KEY=

# --- Private object storage for CVs and generated documents (Phase 2B) ---------
# local | s3   ("local" writes outside the public web folder, under STORAGE_LOCAL_DIR;
#               relative paths are resolved from the repository root. s3 = deployment phase)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Any S3-compatible provider (AWS S3, Cloudflare R2, MinIO, ...)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI (Phase 2C) ----------------------------------------------------------------
# anthropic (default, paid API key) | ollama (FREE model on this computer, see below)
# | fake (scripted demo model for development and tests; refused in production)
AI_PROVIDER=anthropic
# Ollama: install from https://ollama.com/download, then run: ollama pull qwen3:4b-instruct-2507-q4_K_M
# Must be this computer (localhost / 127.0.0.1). Empty = http://127.0.0.1:11434
OLLAMA_BASE_URL=
# Empty = qwen3:4b-instruct-2507-q4_K_M (2.5 GB download, about 4 GB of memory while running)
OLLAMA_MODEL=
# Context window in tokens. Empty = 8192 (enough for the agent, a CV and a job description).
OLLAMA_CONTEXT_TOKENS=
# Let the local model think before each agent step. Empty = false (it can take minutes per step).
OLLAMA_THINKING=
# Anthropic API keys need billing; a Claude.ai subscription is NOT an API key.
# From https://console.anthropic.com - never commit it or paste it in chat.
ANTHROPIC_API_KEY=
# Empty = claude-opus-5-5. Only models with a known price are accepted (cost tracking).
ANTHROPIC_DEFAULT_MODEL=
# Gemini / OpenAI adapters are not built yet (Phase 4).
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
# Any OpenAI-compatible server, e.g. a local model runtime at http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_DEFAULT_MODEL=
# Hard monthly spending cap per user, in USD (checked before every model call).
# REQUIRED for the paid Anthropic API (empty = switched off). Not needed for ollama.
AI_MONTHLY_BUDGET_USD=

# --- Outbound email (Phase 10) - every send still requires explicit approval ---
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# --- Local browser agent (Phase 9) - set on the user's machine only ------------
BROWSER_AGENT_SERVER_URL=
# Dedicated browser profile directory. Stays on the local machine; git-ignored.
BROWSER_AGENT_PROFILE_DIR=.browser-profiles/default
