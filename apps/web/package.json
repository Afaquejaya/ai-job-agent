{
  "name": "@job-agent/web",
  "version": "0.0.0",
  "description": "Next.js web app and API route handlers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "pnpm --filter @job-agent/database db:migrate:test && vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@job-agent/agent-core": "workspace:*",
    "@job-agent/ai-providers": "workspace:*",
    "@job-agent/database": "workspace:*",
    "@job-agent/documents": "workspace:*",
    "@job-agent/job-processing": "workspace:*",
    "@job-agent/observability": "workspace:*",
    "@job-agent/security": "workspace:*",
    "@job-agent/services": "workspace:*",
    "@job-agent/shared": "workspace:*",
    "@job-agent/storage": "workspace:*",
    "@job-agent/task-queue": "workspace:*",
    "better-auth": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
