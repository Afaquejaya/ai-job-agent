{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "APP_URL",
    "LOG_LEVEL",
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "TEST_DATABASE_URL",
    "POSTGRES_*",
    "REDIS_URL",
    "WORKER_HEALTH_PORT",
    "AUTH_SECRET",
    "AUTH_SIGNUP_ALLOWED_EMAILS",
    "DATA_ENCRYPTION_KEY",
    "SEED_DEMO_PASSWORD",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_DIR",
    "S3_*",
    "ANTHROPIC_*",
    "GEMINI_*",
    "OPENAI_*",
    "AI_*",
    "EMAIL_*",
    "BROWSER_AGENT_*",
    "VERCEL_*",
    "CI"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^db:generate", "^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
